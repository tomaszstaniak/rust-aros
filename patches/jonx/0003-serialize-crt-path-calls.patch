+/// One process-wide gate for the C library's path and descriptor-table calls.
+///
+/// A static program's pthreads all call posixc through one shared library base
+/// (the native Pi system of 2026-08-22 gives workers no base of their own).
+/// That base converts every -nix path in one buffer that it reallocates per
+/// call (`__upath.c`, `upathbuf`), keeps one descriptor table that `open`
+/// grows, and one errno cell. Two threads doing path calls at once therefore
+/// hand DOS each other's names (EINVAL, ENOENT, wrong files) and free the
+/// buffer under each other, which TLSF reports as a free outside its area.
+/// The call and the errno it leaves are taken under the gate, so the error
+/// belongs to this call. Reads and writes on an open descriptor do not take
+/// it: they may block, and they do not touch the shared buffer.
+pub(crate) fn crt<T>(f: impl FnOnce() -> T) -> (T, i32) {
+    static GATE: crate::sync::Mutex<()> = crate::sync::Mutex::new(());
+    let _gate = GATE.lock().unwrap_or_else(|e| e.into_inner());
+    let r = f();
+    (r, crate::sys::io::errno())
+}
