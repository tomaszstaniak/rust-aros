+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 John Knipper
+// Shared Path integration for the native DOS grammar only.
+use super::*;
+use crate::sys::path::lex::{Kind, Token};
+
+impl<'a> Components<'a> {
+    #[must_use]
+    #[stable(feature = "rust1", since = "1.0.0")]
+    pub fn as_path(&self) -> &'a Path {
+        // The lexer only splits at ASCII ':' and '/' byte boundaries.
+        unsafe { Path::from_u8_slice(self.inner.remaining()) }
+    }
+    pub(super) fn has_root(&self) -> bool {
+        self.inner.has_root()
+    }
+    fn component(&self, token: Token) -> Component<'a> {
+        let raw = unsafe { OsStr::from_encoded_bytes_unchecked(self.inner.slice(token)) };
+        match token.kind {
+            Kind::Prefix => Component::Prefix(PrefixComponent {
+                raw,
+                parsed: self.prefix.unwrap(),
+            }),
+            Kind::Root => Component::RootDir,
+            Kind::Parent => Component::ParentDir,
+            Kind::Normal => Component::Normal(raw),
+        }
+    }
+}
+#[stable(feature = "rust1", since = "1.0.0")]
+impl<'a> Iterator for Components<'a> {
+    type Item = Component<'a>;
+    fn next(&mut self) -> Option<Component<'a>> {
+        self.inner.next().map(|token| self.component(token))
+    }
+}
+#[stable(feature = "rust1", since = "1.0.0")]
+impl<'a> DoubleEndedIterator for Components<'a> {
+    fn next_back(&mut self) -> Option<Component<'a>> {
+        self.inner.next_back().map(|token| self.component(token))
+    }
+}
+#[stable(feature = "rust1", since = "1.0.0")]
+impl<'a> PartialEq for Components<'a> {
+    fn eq(&self, other: &Self) -> bool {
+        Iterator::eq(self.clone(), other.clone())
+    }
+}
+pub(super) fn compare_components(left: Components<'_>, right: Components<'_>) -> cmp::Ordering {
+    Iterator::cmp(left, right)
+}
+impl Path {
+    #[unstable(feature = "path_trailing_sep", issue = "142503")]
+    pub fn has_trailing_sep(&self) -> bool {
+        self.as_u8_slice()
+            .last()
+            .is_some_and(|&b| b == b'/' || b == b':')
+    }
+    #[unstable(feature = "path_trailing_sep", issue = "142503")]
+    pub fn trim_trailing_sep(&self) -> &Path {
+        // Removing a slash parent would change DOS resolution. Only discard
+        // the single delimiter after a normal leaf, as components also does.
+        self.components().as_path()
+    }
+
+    #[stable(feature = "rust1", since = "1.0.0")]
+    pub fn components(&self) -> Components<'_> {
+        Components {
+            inner: crate::sys::path::lex::Lexer::new(self.as_u8_slice()),
+            prefix: parse_prefix(self.as_os_str()),
+        }
+    }
+}
+impl PathBuf {
+    pub(super) fn _push(&mut self, path: &Path) {
+        crate::sys::path::push(&mut self.inner, path.as_os_str());
+    }
+}
+#[stable(feature = "rust1", since = "1.0.0")]
+impl Hash for Path {
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        // Hash exactly the same DOS components used by Eq and Ord, including
+        // parent slashes and literal dots. Never use Unix's separator fast path.
+        for component in self.components() {
+            component.hash(state);
+        }
+    }
+}
