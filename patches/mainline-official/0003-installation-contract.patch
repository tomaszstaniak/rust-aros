Subject: Fail closed on installed SDK manifests and generation identities

Schema 1 requires the complete managed file set, pinned compiler/profile,
valid hashes of all inputs, and recomputed generation including C flags.
Reject missing, changed or incomplete data before the consumer build.
Base: preceding profile patches on PR1800 2eb81b4. APL 1.1; adaptations
copyright AROS contributors; original John KNIPPER.

--- a/tools/crosstools/rust/unmodified/profiles.py
+++ b/tools/crosstools/rust/unmodified/profiles.py
@@ -24,3 +24,47 @@
 def c_driver(profile, sdk, tools, cc=None, flags=()):
     command = [str(cc.resolve()), *flags] if cc else [str(tools.resolve() / "bin/clang"), "--target=" + profile["triple"]]
     return command + ["--sysroot=" + str(sdk.resolve())]
+
+
+def file_digest(path):
+    import hashlib
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def generation(inputs, triple, flags):
+    import hashlib
+    import json
+    return hashlib.sha256(json.dumps(dict(inputs=inputs, target=triple, cc_args=flags), sort_keys=True).encode()).hexdigest()
+
+
+def validate_installation(prefix, compiler_commit):
+    import json
+    import re
+    from pathlib import Path
+    data = json.loads((prefix / "aros-official-rust.json").read_text())
+    try:
+        if data['schema'] != 1 or data['compiler_commit'] != compiler_commit:
+            raise ValueError('unsupported installation schema or compiler')
+        profile = select(data['profile']['triple'])
+        if data['profile'] != profile:
+            raise ValueError('installation profile changed')
+        expected = {'share/' + profile['triple'] + '.json', 'cargo-config.toml'}
+        expected.update('bin/' + name for name in ('rustc', 'cargo', 'rustdoc', profile['driver']))
+        if set(data['installed']) != expected or not data['inputs']:
+            raise ValueError('incomplete installed files or input identity')
+        if not isinstance(data['cc_args'], list) or not all(isinstance(x, str) for x in data['cc_args']):
+            raise ValueError('invalid C flags')
+        if data['generation'] != generation(data['inputs'], profile['triple'], data['cc_args']):
+            raise ValueError('SDK generation differs from its inputs')
+        for mapping, relative in ((data['installed'], True), (data['inputs'], False)):
+            for name, expected_hash in mapping.items():
+                path = prefix / name if relative else Path(name)
+                if not relative and not path.is_absolute():
+                    raise ValueError('input identity must be absolute')
+                if not isinstance(expected_hash, str) or not re.fullmatch('[0-9a-f]{64}', expected_hash):
+                    raise ValueError('invalid input hash')
+                if not path.is_file() or file_digest(path) != expected_hash:
+                    raise ValueError('installation input changed: ' + str(path))
+    except (KeyError, TypeError) as error:
+        raise ValueError('incomplete installation manifest') from error
+    return data
