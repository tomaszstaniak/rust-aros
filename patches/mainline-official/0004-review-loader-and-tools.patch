Subject: Close review gaps in loader admission and GNU tool selection

Reject allocated x86 relocations outside the explicit static/no-GOT subset,
including large-model GOT64/GOTPC64; require ET_REL SDK startup headers.
Keep the GNU compiler-version default unchanged. GNU official builds are an
explicit pin plus RUST_OFFICIAL_TOOLS selection, with private import support.
Hash the actual LLVM utilities, not an unused Clang when --cc is explicit.
Base: preceding patches on PR1800 2eb81b4. Original John KNIPPER, APL 1.1;
adaptations copyright AROS contributors, APL 1.1.

--- a/tools/crosstools/rust/unmodified/profiles.py
+++ b/tools/crosstools/rust/unmodified/profiles.py
@@ -14,7 +14,7 @@
 
 def validate_sdk(sdk, profile):
     data = (sdk / "lib/startup.o").read_bytes()
-    if len(data) < 64 or data[:6] != bytes.fromhex("7f454c460201") or int.from_bytes(data[18:20], "little") != profile["machine"]:
+    if len(data) < 64 or data[:6] != bytes.fromhex("7f454c460201") or int.from_bytes(data[18:20], "little") != profile["machine"] or int.from_bytes(data[16:18], "little") != 1 or data[7] not in (0, 15) or data[8] not in (0, profile["abi"]):
         raise ValueError("SDK startup CPU/class/endian differs from explicit profile")
     config = sdk / "include/aros/config.h"
     if not config.is_file() or "#define AROS_DOS_PACKETS                1" not in config.read_text():
@@ -68,3 +68,14 @@
     except (KeyError, TypeError) as error:
         raise ValueError('incomplete installation manifest') from error
     return data
+
+
+def validate_relocations(profile, counts):
+    if profile['arch'] == 'x86_64':
+        # Large static model without a GOT; unknown/new encodings fail closed.
+        allowed = {0, 1, 2, 4, 10, 11, 24}
+        invalid = {number for number, count in counts.items() if count and number not in allowed}
+    else:
+        invalid = {number for number in (311, 312) if counts.get(number, 0)}
+    if invalid:
+        raise ValueError('allocated relocations outside the selected loader contract: ' + str(sorted(invalid)))
