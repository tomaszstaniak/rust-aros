@@ -0,0 +1,26 @@
+# Copyright (C) 2026 AROS contributors. Licensed under APL 1.1.
+"""Explicit CPU admission; compilation never establishes runtime qualification."""
+PROFILES = {
+    "aarch64-unknown-aros": dict(arch="aarch64", machine=183, abi=1, driver="aarch64-aros-cc", runtime="UNTESTED"),
+    "x86_64-unknown-aros": dict(arch="x86_64", machine=62, abi=1, driver="x86_64-aros-cc", runtime="UNTESTED"),
+}
+
+
+def select(triple):
+    if triple not in PROFILES:
+        raise ValueError("unsupported official native profile: " + triple)
+    return dict(PROFILES[triple], triple=triple)
+
+
+def validate_sdk(sdk, profile):
+    data = (sdk / "lib/startup.o").read_bytes()
+    if len(data) < 64 or data[:6] != bytes.fromhex("7f454c460201") or int.from_bytes(data[18:20], "little") != profile["machine"]:
+        raise ValueError("SDK startup CPU/class/endian differs from explicit profile")
+    config = sdk / "include/aros/config.h"
+    if not config.is_file() or "#define AROS_DOS_PACKETS                1" not in config.read_text():
+        raise ValueError("require native mainline ABIv1 SDK configuration, not ABIv11")
+
+
+def c_driver(profile, sdk, tools, cc=None, flags=()):
+    command = [str(cc.resolve()), *flags] if cc else [str(tools.resolve() / "bin/clang"), "--target=" + profile["triple"]]
+    return command + ["--sysroot=" + str(sdk.resolve())]
