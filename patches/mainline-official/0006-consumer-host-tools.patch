--- /dev/null
+++ b/tools/crosstools/rust/unmodified/consumer-host-probe/build.rs
@@ -0,0 +1,14 @@
+// APL 1.1, copyright 2026 AROS contributors.
+use std::{env, fs, process::Command};
+fn main() {
+    let result = Command::new(env::var_os("RUSTC").unwrap()).arg("-Vv").output().unwrap();
+    assert!(result.status.success());
+    let version = String::from_utf8(result.stdout).unwrap();
+    let commit = env::var("AROS_EXPECTED_COMPILER").unwrap();
+    let host = env::var("HOST").unwrap();
+    assert!(version.contains(&format!("commit-hash: {commit}\n")));
+    assert!(version.contains(&format!("host: {host}\n")));
+    fs::write(std::path::Path::new(&env::var_os("OUT_DIR").unwrap()).join("host-tools.txt"),
+              format!("{version}HOST={host}\nTARGET={}\n", env::var("TARGET").unwrap())).unwrap();
+    println!("cargo:rerun-if-env-changed=AROS_EXPECTED_COMPILER");
+}
--- /dev/null
+++ b/tools/crosstools/rust/unmodified/consumer-host-probe/src/lib.rs
@@ -0,0 +1,6 @@
+// APL 1.1, copyright 2026 AROS contributors.
+extern crate proc_macro;
+#[proc_macro]
+pub fn stamp(_: proc_macro::TokenStream) -> proc_macro::TokenStream {
+    "7u32".parse().unwrap()
+}
