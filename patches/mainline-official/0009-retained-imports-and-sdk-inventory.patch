Subject: Bind requested imports and consumer SDK inventory to retained builds

Close review finding: changing --posix-stubs must not stamp a new generation
on retained older imports. Require exact requested/retained identities including
presence/absence. Reject added or removed SDK files before consumer compilation
and recheck the full inventory afterward, not just enumerated old hashes.
Base: preceding patches on PR1800 2eb81b4. Original John KNIPPER, APL 1.1;
adaptations copyright AROS contributors, APL 1.1.

--- a/tools/crosstools/rust/unmodified/profiles.py
+++ b/tools/crosstools/rust/unmodified/profiles.py
@@ -93,3 +93,14 @@
     paths.append(cc.resolve() if cc else tools.resolve() / 'bin/clang')
     paths.extend(p for directory in ('include', 'lib') for p in (sdk.resolve() / directory).rglob('*') if p.is_file())
     return {str(p): file_digest(p) for p in paths}
+
+
+def validate_imports(retained, requested):
+    expected = {'libaros_positional.a': file_digest(requested.resolve())} if requested else {}
+    if retained != expected:
+        raise ValueError('requested positioned imports differ from the retained native build')
+
+
+def sdk_inputs(sdk):
+    return {str(p): file_digest(p) for directory in ('include', 'lib')
+            for p in (sdk.resolve() / directory).rglob('*') if p.is_file()}
