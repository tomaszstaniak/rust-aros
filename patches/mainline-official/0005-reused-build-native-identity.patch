Subject: Bind reusable std output to the SDK and C tool contents

An unchanged path is not an unchanged SDK. Record all SDK headers/libraries
and actual C/collect/LLVM tool hashes at native build start, check them again
at completion and require exact equality before reusing compiled std.
Base: preceding patches on PR1800 2eb81b4. APL 1.1. Original John KNIPPER;
adaptations copyright AROS contributors.

--- a/tools/crosstools/rust/unmodified/profiles.py
+++ b/tools/crosstools/rust/unmodified/profiles.py
@@ -79,3 +79,12 @@
         invalid = {number for number in (311, 312) if counts.get(number, 0)}
     if invalid:
         raise ValueError('allocated relocations outside the selected loader contract: ' + str(sorted(invalid)))
+
+
+def native_inputs(sdk, tools, collect, cc=None):
+    paths = [collect.resolve()]
+    for name in ('llvm-ar', 'llvm-nm', 'llvm-objcopy', 'ld.lld'):
+        paths.append(tools.resolve() / 'bin' / name)
+    paths.append(cc.resolve() if cc else tools.resolve() / 'bin/clang')
+    paths.extend(p for directory in ('include', 'lib') for p in (sdk.resolve() / directory).rglob('*') if p.is_file())
+    return {str(p): file_digest(p) for p in paths}
