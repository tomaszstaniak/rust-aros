Subject: Seal stock source inventory and fingerprint actual SDK libraries

The earlier manifest checked only 37 patch preimages/absences. Generate the
full stock manifest from the channel-pinned rust-src archive (SHA-256
 ef2574ae2ae7b18a51ae74e29d2acd2fe0052efddfdbf9cd0328258775018acf),
covering 3682 files, and reject modified/missing/extra source files.
Bind native results to that manifest. Include stock inputs in the build cache
key and actual verified std/adapter/import products in the installed SDK
identity, so another compiled sysroot cannot reuse the old Cargo generation.
Base: preceding patches on PR1800 2eb81b4. Original John KNIPPER, APL 1.1;
adaptations copyright AROS contributors, APL 1.1. Hash metadata derives from
official Rust source (Apache-2.0/MIT), not a compiler modification.

--- a/tools/crosstools/rust/unmodified/profiles.py
+++ b/tools/crosstools/rust/unmodified/profiles.py
@@ -108,3 +108,13 @@
 def sdk_inputs(sdk):
     return {str(p): file_digest(p) for directory in ('include', 'lib')
             for p in (sdk.resolve() / directory).rglob('*') if p.is_file()}
+
+
+def validate_stock_source(source, manifest):
+    expected = {name for name, value in manifest.items() if value is not None}
+    actual = {str(p.relative_to(source)) for p in source.rglob('*') if p.is_file()}
+    if actual != expected:
+        raise ValueError('stock source inventory mismatch: ' + str(sorted(actual ^ expected)[:5]))
+    for name in sorted(expected):
+        if file_digest(source / name) != manifest[name]:
+            raise ValueError('modified stock source: ' + name)
