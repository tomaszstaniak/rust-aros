# inventory 0.3.24: AROS constructor registration (MIT OR Apache-2.0).
# GCC 10.5 (x86_64) emits .ctors, Clang (AArch64) .init_array; absent cfg leaves
# __CTOR in ordinary data.
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -562,6 +562,9 @@
                 link_section = "__DATA,__mod_init_func,mod_init_funcs",
             )]
             #[cfg_attr(windows, link_section = ".CRT$XCU")]
+            // Match the constructor section of the AROS C compiler for the architecture.
+            #[cfg_attr(all(target_os = "aros", target_arch = "x86_64"), link_section = ".ctors")]
+            #[cfg_attr(all(target_os = "aros", target_arch = "aarch64"), link_section = ".init_array")]
             static __CTOR: unsafe extern "C" fn() = __ctor;
         };
     };
